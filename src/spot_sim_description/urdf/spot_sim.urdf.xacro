<?xml version="1.0"?>
<!--
  Simulated Spot: the spot_description model (legs only, no arm) plus the
  locomotion base plugin. Converted to SDF by spot_sim_bringup at launch.
-->
<robot name="spot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Plugin implementing locomotion; swap for another base (e.g. an RL policy). -->
  <xacro:arg name="base_plugin" default="KinematicBaseSystem"/>

  <xacro:include filename="$(find spot_description)/urdf/spot_macro.xacro"/>
  <xacro:load_spot arm="false" feet="false" gripperless="false" tf_prefix="" include_transmissions="false"/>

  <gazebo>
    <plugin filename="$(arg base_plugin)" name="spot_sim_gz::$(arg base_plugin)"/>
  </gazebo>
</robot>
