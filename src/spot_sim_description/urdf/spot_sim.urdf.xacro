<?xml version="1.0"?>
<!--
  Simulated Spot: the spot_description model plus the locomotion base plugin
  and, optionally, the Spot Arm with its plugin and the five body cameras.
  Converted to SDF by spot_sim_bringup at launch.
-->
<robot name="spot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Plugin implementing locomotion; swap for another base (e.g. an RL policy). -->
  <xacro:arg name="base_plugin" default="KinematicBaseSystem"/>
  <!-- Spot Arm with gripper, moved by its own plugin (swappable like the base). -->
  <xacro:arg name="arm" default="false"/>
  <xacro:arg name="arm_plugin" default="KinematicArmSystem"/>
  <!-- Body cameras need rendering (the world's Sensors system); off by default. -->
  <xacro:arg name="cameras" default="false"/>
  <xacro:arg name="camera_rate" default="15"/>

  <xacro:include filename="$(find spot_description)/urdf/spot_macro.xacro"/>
  <xacro:load_spot arm="$(arg arm)" feet="false" gripperless="false" tf_prefix="" include_transmissions="false"/>

  <gazebo>
    <plugin filename="$(arg base_plugin)" name="spot_sim_gz::$(arg base_plugin)"/>
  </gazebo>
  <xacro:if value="$(arg arm)">
    <gazebo>
      <plugin filename="$(arg arm_plugin)" name="spot_sim_gz::$(arg arm_plugin)"/>
    </gazebo>
  </xacro:if>

  <!--
    Each Spot body camera: a visual camera (640x480, like the robot's
    fisheye cameras but with pinhole optics) and, 3 cm to its right, a depth
    sensor (424x240, like the robot's stereo depth). SpotApiSystem serves
    <name>_fisheye_image, <name>_depth and <name>_depth_in_visual_frame from
    them. Approximate mounting: the front pair at the nose, cross-eyed and
    tilted down; one per side; one at the back.
  -->
  <xacro:macro name="body_camera" params="name x y z pitch yaw">
    <gazebo reference="body">
      <sensor name="${name}" type="camera">
        <pose>${x} ${y} ${z} 0 ${pitch} ${yaw}</pose>
        <topic>spot_sim/camera/${name}/image</topic>
        <update_rate>$(arg camera_rate)</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.6</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>50.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
    <gazebo reference="body">
      <!-- 3 cm to the camera's right (its -y axis; pitch does not move that axis). -->
      <sensor name="${name}_depth" type="depth_camera">
        <pose>${x + 0.03 * sin(yaw)} ${y - 0.03 * cos(yaw)} ${z} 0 ${pitch} ${yaw}</pose>
        <topic>spot_sim/depth/${name}/image</topic>
        <update_rate>$(arg camera_rate)</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>424</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!--
    The gripper camera, in the palm between the jaws, looking forward: as on
    the robot, the closed gripper blocks most of the view; open it to see. A
    visual camera (640x480, ~60 deg, like the robot's at its default
    resolution) and, 2 cm to its right, a time-of-flight depth sensor
    (224x171, wider). SpotApiSystem serves hand_color_image, hand_depth and
    hand_depth_in_hand_color_frame from them.
  -->
  <xacro:macro name="hand_camera" params="x z">
    <gazebo reference="arm_link_wr1">
      <sensor name="hand" type="camera">
        <pose>${x} 0 ${z} 0 0 0</pose>
        <topic>spot_sim/camera/hand/image</topic>
        <update_rate>$(arg camera_rate)</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>50.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
    <gazebo reference="arm_link_wr1">
      <sensor name="hand_depth" type="depth_camera">
        <pose>${x} -0.02 ${z} 0 0 0</pose>
        <topic>spot_sim/depth/hand/image</topic>
        <update_rate>$(arg camera_rate)</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>224</width><height>171</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>4.0</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:if value="$(arg cameras)">
    <xacro:if value="$(arg arm)">
      <xacro:hand_camera x="0.145" z="-0.015"/>
    </xacro:if>
    <xacro:body_camera name="frontleft" x="0.45" y="0.045" z="-0.03" pitch="0.35" yaw="-0.25"/>
    <xacro:body_camera name="frontright" x="0.45" y="-0.045" z="-0.03" pitch="0.35" yaw="0.25"/>
    <xacro:body_camera name="left" x="-0.1" y="0.125" z="0.0" pitch="0.25" yaw="${pi/2}"/>
    <xacro:body_camera name="right" x="-0.1" y="-0.125" z="0.0" pitch="0.25" yaw="${-pi/2}"/>
    <xacro:body_camera name="back" x="-0.44" y="0.0" z="0.0" pitch="0.25" yaw="${pi}"/>
  </xacro:if>
</robot>
