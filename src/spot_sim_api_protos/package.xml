<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spot_sim_api_protos</name>
  <version>0.1.0</version>
  <description>Spot SDK API protobuf messages and gRPC services compiled for C++ (server side of the Spot simulator).</description>
  <maintainer email="max.schik@googlemail.com">Max Schik</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>protobuf-dev</depend>
  <depend>libgrpc++-dev</depend>
  <build_depend>protobuf-compiler-grpc</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
