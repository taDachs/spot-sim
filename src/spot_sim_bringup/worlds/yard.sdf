<?xml version="1.0" ?>
<!--
  Flat world with a simulated Spot and a few objects around it, one in view
  of each body camera: a red box ahead, a green cylinder left, a yellow
  sphere right, a blue wall behind.
  Dollar placeholders are substituted by sim.launch.py; "robot" becomes the
  Spot model (spot_sim_description), named after "model_name".
-->
<sdf version="1.9">
  <world name="spot_world">
    <physics name="default_physics" default="true" type="ignored">
      <max_step_size>${step_size}</max_step_size>
      <real_time_factor>${rtf}</real_time_factor>
    </physics>

    <!-- Listing any plugin disables Gazebo's defaults, so name them explicitly. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    ${sensors_plugin}

    <plugin filename="SpotApiSystem" name="spot_sim_gz::SpotApiSystem">
      <nickname>spot-sim</nickname>
      <username>${username}</username>
      <password>${password}</password>
      <port>${port}</port>
      <model_name>${model_name}</model_name>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Things for the cameras to look at (the kinematic base walks through them). -->
    <model name="red_box">
      <static>true</static>
      <pose>2.5 0.0 0.4 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="green_cylinder">
      <static>true</static>
      <pose>0.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="blue_wall">
      <static>true</static>
      <pose>-3.0 0.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4.0 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.0 1.5</size></box></geometry>
          <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="yellow_sphere">
      <static>true</static>
      <pose>0.5 -2.0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material><ambient>0.7 0.7 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    ${robot}
  </world>
</sdf>
